# NaniAI — STAGING Supabase credentials (copy to .env.staging; .env.staging is gitignored).
# These MUST point at a DEDICATED staging project — never production.
# Get them from Supabase → Project Settings → API (of your staging project).
STAGING_SUPABASE_URL=https://<your-staging-ref>.supabase.co
STAGING_SUPABASE_ANON_KEY=<staging anon public key>
STAGING_SUPABASE_SERVICE_ROLE_KEY=<staging service role key — used only to create/delete test accounts>

# NaniAI environment configuration
# The app runs fully in deterministic MOCK mode with NO keys set.
# Fill these in to light up live Qloo + live model reasoning.

# ---- Qloo (hackathon) ----
# Request key at the Qloo hackathon dev guide; issued by email in a few business days.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# ---- Model gateway ----
# MODEL_PROVIDER selects the reasoning "brain": mock | anthropic | nebius
MODEL_PROVIDER=mock

# Default LLM (Qloo edition) — optional
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Nebius + NVIDIA open model (Nebius edition) — OpenAI-compatible endpoint
# Verify exact model id in the Nebius Token Factory / AI Studio console.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
# Heavy reasoning (negotiation): a large Nemotron (e.g. Ultra / 70B).
NEBIUS_MODEL=nvidia/llama-3.1-nemotron-70b-instruct
# Fast everyday calls (short summaries): a smaller Nemotron (Nano/Super) keeps
# the app responsive and credits stretched, as the Nebius brief recommends.
NEBIUS_MODEL_FAST=nvidia/nemotron-nano-9b-v2

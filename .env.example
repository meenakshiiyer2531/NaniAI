# NaniAI environment configuration
# The app runs fully in deterministic MOCK mode with NO keys set.
# Fill these in to light up the live Qloo taste graph + a live LLM.

# ---- Qloo (cultural intelligence) ----
# Request a key via the Qloo hackathon dev guide; issued by email.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# ---- Model gateway (optional reasoning LLM) ----
# MODEL_PROVIDER selects the brain: mock | openai
#   mock   -> deterministic, keyless (default)
#   openai -> any OpenAI-compatible endpoint (configure the three vars below)
MODEL_PROVIDER=mock

# Point these at ANY OpenAI-compatible host serving an NVIDIA open-source model:
#   NVIDIA API (free credits):  LLM_BASE_URL=https://integrate.api.nvidia.com/v1
#   Nebius Token Factory:       LLM_BASE_URL=https://api.studio.nebius.ai/v1   (required for the Nebius track)
LLM_BASE_URL=
LLM_API_KEY=
# e.g. an NVIDIA Nemotron model id, confirmed in your provider's catalog:
LLM_MODEL=nvidia/llama-3.1-nemotron-70b-instruct

# Optional: only set these to show a cost estimate (USD per 1M tokens).
# Leave blank and no cost is invented.
LLM_PRICE_IN=
LLM_PRICE_OUT=

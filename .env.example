# NaniAI environment configuration
# The app runs fully in deterministic MOCK mode with NO keys set.
# Fill these in to light up the live Qloo taste graph + a live LLM.

# ---- Qloo (cultural intelligence) ----
# Request a key via the Qloo hackathon dev guide; issued by email.
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# ---- Model gateway (AI reasoning: chatbot + plan explanations) ----
# Explicit provider selection (never guessed from a model name):
#   MODEL_PROVIDER=mock    -> deterministic, keyless (default; labeled as mock)
#   MODEL_PROVIDER=nvidia  -> the default NVIDIA/OpenAI-compatible path (LLM_* below)
#   MODEL_PROVIDER=nebius  -> Nebius Token Factory (NEBIUS_* below)
#   (unset) -> auto: use Nebius if NEBIUS_API_KEY+NEBIUS_MODEL are set, else the
#              NVIDIA path if configured, else mock. End users never enter a key.
MODEL_PROVIDER=mock

# -- Default NVIDIA / OpenAI-compatible provider (Mode A) --
# NVIDIA API (free credits):  LLM_BASE_URL=https://integrate.api.nvidia.com/v1
# NOTE: NVIDIA's own API is NOT Nebius infrastructure — it does not satisfy the
# Nebius hackathon track on its own. Use the NEBIUS_* path below for that.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=nvidia/nemotron-3.5-bolt-e4b

# -- Nebius Token Factory provider (Mode B — required for the Nebius track) --
# Set these (owner-configured, server-side only) to run inference on Nebius.
# Confirm an NVIDIA open-source model id from the Token Factory catalog:
#   curl -s https://api.tokenfactory.nebius.com/v1/models -H "Authorization: Bearer $KEY" | grep -i nvidia
# Verify with:  npm run verify:nebius   (fails unless the request truly hits Nebius)
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
NEBIUS_API_KEY=
NEBIUS_MODEL=

# Optional: only set these to show a cost estimate (USD per 1M tokens).
# Leave blank and no cost is invented.
LLM_PRICE_IN=
LLM_PRICE_OUT=

# ---- Supabase (real auth + per-user profiles) — AWAITING CONFIGURATION ----
# Create a free project at https://supabase.com, run supabase/migrations/0001_init.sql
# in the SQL editor, then fill these. The anon key is browser-safe; the service_role
# key is SERVER-ONLY (never expose it to the client).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ---- BYOK encryption (per-user API keys) ----
# Server-only master key for AES-256-GCM encryption of user-provided API keys
# (migration 0004 / public.user_api_keys). REQUIRED for the "bring your own key"
# feature; if unset, the app fails safe and refuses to store a key (never plaintext).
# Must be 32 bytes. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Keep it ONLY here / in your host's secret manager — never in the DB, never NEXT_PUBLIC_*.
BYOK_ENCRYPTION_KEY=
